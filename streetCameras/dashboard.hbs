<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Calgary Timelapse Server</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; padding: 2rem; margin: 0; }
    h1 { margin-bottom: 0.5rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .card { background: #1e293b; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3); }
    .card h2 { margin-top: 0; color: #38bdf8; display: flex; justify-content: space-between; align-items: center; }
    .preview-img { width: 100%; height: auto; border-radius: 6px; background: #000; margin-bottom: 1rem; aspect-ratio: 16/9; object-fit: cover; }
    button { background: #0284c7; color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 6px; cursor: pointer; font-weight: 600; transition: background 0.2s; }
    button:hover { background: #0369a1; }
    .badge { font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 9999px; background: #334155; color: #cbd5e1; }
    ul { padding-left: 1.2rem; }
    li { margin-bottom: 0.4rem; }
    a { color: #38bdf8; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
  <script>
    async function triggerExport(camId) {
      if (!confirm('Force export video now for ' + camId + '?')) return;
      const res = await fetch('/api/export/' + camId, { method: 'POST' });
      const data = await res.json();
      alert(data.message || data.error);
      location.reload();
    }
    setInterval(() => {
      document.querySelectorAll('.preview-img').forEach(img => {
        const camId = img.dataset.cam;
        img.src = '/api/latest/' + camId + '?t=' + Date.now();
      });
    }, 10000);
  </script>
</head>
<body>
  <h1>Traffic Cam Timelapse Server</h1>
  <p>Active Cameras: {{cameraCount}} • FPS: {{fps}}</p>
  <div class="grid">
    {{#each cameras}}
    <div class="card">
      <h2>{{this.id}} <span class="badge">{{this.frameCount}} frames ({{this.mbUsed}} MB)</span></h2>
      <img class="preview-img" data-cam="{{this.id}}" src="/api/latest/{{this.id}}" alt="Live Preview" />
      <p><strong>Status:</strong> {{this.lastCaptureStatus}}</p>
      <p><strong>Last Capture:</strong> {{this.lastCaptureFormatted}}</p>
      <button onclick="triggerExport('{{this.id}}')">Export Video Now</button>

      <h3>Recorded Videos:</h3>
      <ul>
        {{#if this.videos.length}}
          {{#each this.videos}}
          <li><a href="/timelapses/{{../this.id}}/{{this}}" target="_blank">{{this}}</a></li>
          {{/each}}
        {{else}}
          <li><em>No videos generated yet.</em></li>
        {{/if}}
      </ul>
    </div>
    {{/each}}
  </div>
</body>
</html>