<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Calgary Timelapse Server</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; padding: 2rem; margin: 0; }
    h1 { margin-bottom: 0.5rem; }
    .topbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
    .panel { background: #1e293b; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3); margin-bottom: 1.5rem; }
    .form-row { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
    input { background: #0f172a; color: #f8fafc; border: 1px solid #334155; border-radius: 6px; padding: 0.6rem 0.8rem; font-size: 0.95rem; }
    input.url-input { flex: 1; min-width: 260px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 1.5rem; }
    .card { background: #1e293b; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3); }
    .card h2 { margin-top: 0; color: #38bdf8; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
    .preview-img { width: 100%; height: auto; border-radius: 6px; background: #000; margin-bottom: 1rem; aspect-ratio: 16/9; object-fit: cover; }
    button { background: #0284c7; color: white; border: none; padding: 0.55rem 1rem; border-radius: 6px; cursor: pointer; font-weight: 600; transition: background 0.2s; }
    button:hover { background: #0369a1; }
    button.secondary { background: #475569; }
    button.secondary:hover { background: #334155; }
    button.danger { background: #dc2626; }
    button.danger:hover { background: #b91c1c; }
    .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
    .badge { font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 9999px; background: #334155; color: #cbd5e1; }
    .badge.paused { background: #78350f; color: #fde68a; }
    .url-text { font-size: 0.8rem; color: #94a3b8; word-break: break-all; margin: 0.25rem 0 0.75rem; }
    ul { padding-left: 1.2rem; }
    li { margin-bottom: 0.4rem; }
    a { color: #38bdf8; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
  <script>
    async function addCamera(e) {
      e.preventDefault();
      const id = document.getElementById('newCamId').value.trim();
      const url = document.getElementById('newCamUrl').value.trim();
      const res = await fetch('api/cameras', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, url }),
      });
      const data = await res.json();
      alert(data.message || data.error);
      if (res.ok) location.reload();
    }

    async function updateCamera(camId) {
      const urlInput = document.getElementById('url-' + camId);
      const url = urlInput ? urlInput.value.trim() : '';
      const res = await fetch('api/cameras/' + encodeURIComponent(camId), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const data = await res.json();
      alert(data.message || data.error);
      if (res.ok) location.reload();
    }

    async function toggleCamera(camId, enabled) {
      const res = await fetch('api/cameras/' + encodeURIComponent(camId), {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled }),
      });
      const data = await res.json();
      alert(data.message || data.error);
      if (res.ok) location.reload();
    }

    async function deleteCamera(camId) {
      if (!confirm('Remove camera ' + camId + ' from SQLite and stop its worker?')) return;
      const res = await fetch('api/cameras/' + encodeURIComponent(camId), {
        method: 'DELETE',
      });
      const data = await res.json();
      alert(data.message || data.error);
      if (res.ok) location.reload();
    }

    async function restartWorkers() {
      if (!confirm('Restart all camera workers and reload cameras from SQLite?')) return;
      const res = await fetch('api/workers/restart', { method: 'POST' });
      const data = await res.json();
      alert(data.message || data.error);
      if (res.ok) location.reload();
    }

    async function triggerExport(camId) {
      if (!confirm('Force export video now for ' + camId + '?')) return;
      const res = await fetch('api/export/' + encodeURIComponent(camId), { method: 'POST' });
      const data = await res.json();
      alert(data.message || data.error);
      location.reload();
    }

    setInterval(() => {
      document.querySelectorAll('.preview-img').forEach(img => {
        const camId = img.dataset.cam;
        img.src = 'api/latest/' + encodeURIComponent(camId) + '?t=' + Date.now();
      });
    }, 10000);
  </script>
</head>
<body>
  <div class="topbar">
    <div>
      <h1>Traffic Cam Timelapse Server</h1>
      <p>SQLite Cameras: {{cameraCount}} • FPS: {{fps}} • DB: {{dbPath}}</p>
    </div>
    <button class="secondary" onclick="restartWorkers()">Restart Workers</button>
  </div>

  <div class="panel">
    <h2 style="margin-top:0;color:#38bdf8;">Add Camera</h2>
    <form class="form-row" onsubmit="addCamera(event)">
      <input id="newCamId" type="text" placeholder="Camera ID (e.g. loc12)" required />
      <input id="newCamUrl" class="url-input" type="url" placeholder="https://trafficcam.calgary.ca/ss/0/loc12.jpg" required />
      <button type="submit">Add Camera</button>
    </form>
  </div>

  <div class="grid">
    {{#each cameras}}
    <div class="card">
      <h2>
        <span>{{this.id}}</span>
        <span>
          {{#unless this.enabled}}<span class="badge paused">Paused</span>{{/unless}}
          <span class="badge">{{this.frameCount}} frames ({{this.mbUsed}} MB)</span>
        </span>
      </h2>
      <p class="url-text">{{this.url}}</p>
      <img class="preview-img" data-cam="{{this.id}}" src="api/latest/{{this.id}}" alt="Live Preview" />
      <p><strong>Status:</strong> {{this.lastCaptureStatus}}</p>
      <p><strong>Last Capture:</strong> {{this.lastCaptureFormatted}}</p>

      <div class="form-row" style="margin-top:0.5rem;">
        <input id="url-{{this.id}}" class="url-input" type="url" value="{{this.url}}" />
        <button class="secondary" onclick="updateCamera('{{this.id}}')">Save URL</button>
      </div>

      <div class="actions">
        <button onclick="triggerExport('{{this.id}}')">Export Video Now</button>
        {{#if this.enabled}}
          <button class="secondary" onclick="toggleCamera('{{this.id}}', false)">Pause</button>
        {{else}}
          <button onclick="toggleCamera('{{this.id}}', true)">Resume</button>
        {{/if}}
        <button class="danger" onclick="deleteCamera('{{this.id}}')">Delete</button>
      </div>

      <h3>Recorded Videos:</h3>
      <ul>
        {{#if this.videos.length}}
          {{#each this.videos}}
          <li><a href="timelapses/{{../this.id}}/{{this}}" target="_blank">{{this}}</a></li>
          {{/each}}
        {{else}}
          <li><em>No videos generated yet.</em></li>
        {{/if}}
      </ul>
    </div>
    {{/each}}
  </div>
</body>
</html>